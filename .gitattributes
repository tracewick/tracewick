* text=auto eol=lf

*.php diff=php

# Golden pprof files are raw protobuf and must never get line ending conversion.
*.pb binary

# Spool fixtures are binary files shared with readers in other languages.
*.spool binary

# Keep the Composer dist archive limited to runtime code and legal files.
/.dockerignore                     export-ignore
/.editorconfig                     export-ignore
/.gitattributes                    export-ignore
/.github/                          export-ignore
/.gitignore                        export-ignore
/.php-cs-fixer.dist.php            export-ignore
/.release-please-manifest.json     export-ignore
/AGENTS.md                         export-ignore
/CHANGELOG.md                      export-ignore
/CODE_OF_CONDUCT.md                export-ignore
/CONTRIBUTING.md                   export-ignore
/Makefile                          export-ignore
/SECURITY.md                       export-ignore
/compose.yaml                      export-ignore
/composer-dependency-analyser.php  export-ignore
/docker/                           export-ignore
/docs/                             export-ignore
/infection.json5                    export-ignore
/phpstan.neon.dist                 export-ignore
/phpunit.xml.dist                  export-ignore
/rector.php                        export-ignore
/release-please-config.json        export-ignore
/tests/                            export-ignore
/version.txt                       export-ignore
