# syntax=docker/dockerfile:1

# Proof recipe: PHP CLI on Alpine with ext-excimer from PECL.
# Not a published Tracewick runtime image — copy the RUN block into your own Dockerfile
# or follow docs/install-excimer.md. The Bookworm stand (`Dockerfile`) remains the default
# development image.
#
# Build:
#   docker build -f docker/php/Dockerfile.alpine --build-arg PHP_VERSION=8.4 -t tracewick-php-alpine:local docker/php

ARG PHP_VERSION=8.4

FROM composer:2 AS composer

FROM php:${PHP_VERSION}-cli-alpine

ARG EXCIMER_VERSION=1.2.6

RUN apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
    && pecl install "excimer-${EXCIMER_VERSION}" \
    && docker-php-ext-enable excimer \
    && apk del .build-deps \
    && rm -rf /tmp/pear \
    && php -r 'exit(extension_loaded("excimer") ? 0 : 1);'

# Optional tooling for local experiments (not required for the extension itself).
RUN apk add --no-cache git make unzip

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY conf.d/ /usr/local/etc/php/conf.d/

ENV COMPOSER_CACHE_DIR=/composer-cache \
    COMPOSER_HOME=/tmp/composer-home
RUN mkdir -p "$COMPOSER_CACHE_DIR" "$COMPOSER_HOME" \
    && chmod 1777 "$COMPOSER_CACHE_DIR" "$COMPOSER_HOME"

WORKDIR /app
