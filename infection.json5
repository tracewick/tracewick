{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.8/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log",
        "github": true
    },
    "mutators": {
        "@default": true,
        "MethodCallRemoval": {
            "ignoreSourceCodeByRegex": [
                // Equivalent mutant: ExcimerTraceConverter cuts every trace at the same depth, so
                // the limit inside the extension only saves memory and cannot be observed.
                "\\$this->profiler->setMaxDepth\\(.*",
            ],
        },
        "ReturnRemoval": {
            // Equivalent mutant with Excimer 1.2: restarting a running profiler keeps sampling,
            // so the guard against it cannot be observed. It stays as protection against
            // extension versions that reset the timer on restart.
            "ignore": ["Tracewick\\Sampler\\ExcimerSampler::start"],
        },
        "LogicalAnd": {
            "ignoreSourceCodeByRegex": [
                // Equivalent mutant: the second is_dir() in SpoolTransport only matters when another
                // process creates the spool directory between the first check and mkdir().
                "if \\(!is_dir\\(\\$directory\\) && !@mkdir.*",
                // Same for the rejected directory of DirectorySpoolSource.
                "\\|\\| \\(!is_dir\\(\\$rejected\\) && !@mkdir.*",
            ],
        },
        "LogicalNot": {
            "ignoreSourceCodeByRegex": [
                // See LogicalAnd: mkdir() of the rejected directory only fails on a race or I/O error.
                "\\|\\| \\(!is_dir\\(\\$rejected\\) && !@mkdir.*",
            ],
        },
        "FunctionCallRemoval": {
            "ignoreSourceCodeByRegex": [
                // PHP clears the stat cache itself when this process renames or touches a file, so
                // a stale entry only appears when another process changes it between two scans.
                "clearstatcache\\(.*",
            ],
        },
        "LessThan": {
            "ignoreSourceCodeByRegex": [
                // Equivalent in tests: free space would have to equal the limit to the byte.
                "if \\(false !== \\$free && .*",
            ],
        },
        "Concat": {
            "ignoreSourceCodeByRegex": [
                // The temporary name of a spool file is visible only to a concurrent reader.
                "\\$temporary = \\$directory \\. .*",
            ],
        },
        "ConcatOperandRemoval": {
            "ignoreSourceCodeByRegex": [
                // See Concat.
                "\\$temporary = \\$directory \\. .*",
            ],
        },
    },
    // Plan target for 1.0: MSI >= 80%. Raise these as the test suite matures, never lower them.
    "minMsi": 80,
    "minCoveredMsi": 80
}
